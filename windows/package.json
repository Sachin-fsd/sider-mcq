{
  "name": "screensum-electron",
  "version": "1.1.0",
  "description": "MCQ Solver with AI - Multi-Key Rotation Support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac --x64",
    "postinstall": "node scripts/postinstall.js"
  },
  "author": "Your Name",
  "license": "MIT",
  "build": {
    "appId": "com.screensum.app",
    "productName": "ScreenSum",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!python",
      "!venv",
      "!dist",
      "!release"
    ],
    "extraResources": [
      {
        "from": "dist/backend.exe",
        "to": "backend.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}